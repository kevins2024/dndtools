  "main": "index.js",
  "scripts": {
    "front": "vue-cli-service serve",
    "back": "node server.js",
    "serve": "concurrently -n front,back,ready -c blue,green,yellow \"vue-cli-service serve\" \"node server.js\" \"node scripts/wait-ready.js\"",
    "stop": "lsof -ti:8080,8081,3001 -sTCP:LISTEN | xargs -r kill",
    "build": "vue-cli-service build",
    "deploy": "npm run build && gh-pages -d dist",
    "test": "echo \"Error: no test specified\" && exit 1",
    "update-ids": "node update-ids.js",
    "copy-world": "node copy-world.js",
    "postinstall": "node scripts/install-hooks.js"
  },
