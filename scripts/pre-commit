#!/bin/sh
# Runs Prettier on staged files before each commit, then re-stages the
# formatted result. Checked into scripts/ because .git/hooks isn't tracked
# by git — see scripts/README.md (or the repo root CLAUDE.md) for how to
# install it into a fresh checkout.
#
# Added 2026-09-09: prior sessions without this hook let files drift out of
# Prettier's formatting a little at a time, until some unrelated edit
# happened to touch the same file and Prettier reformatted the whole thing
# in one big, noisy diff. Running this on every commit keeps that from
# accumulating.

staged_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.js' '*.vue' '*.json' '*.css' '*.md')

if [ -z "$staged_files" ]; then
  exit 0
fi

echo "$staged_files" | xargs npx prettier --write

echo "$staged_files" | xargs git add

exit 0
